{
  "name": "cv",
  "description": "Curriculum Vitae",
  "version": "1.0.0",
  "author": "Marko Marković <okram@civokram.com>",
  "license": "MIT",
  "private": true,
  "type": "module",
  "devDependencies": {
    "@iconify-json/tabler": "1.2.39",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "lint-staged": "17.5.1",
    "prettier": "3.9.6",
    "puppeteer": "25.11.0",
    "replace-in-files-cli": "4.0.0",
    "simple-git-hooks": "2.14.0",
    "vite": "8.3.0",
    "vite-plugin-singlefile": "2.3.3"
  },
  "scripts": {
    "build": "pnpm run build:html && pnpm run build:timestamp && pnpm run build:pdf",
    "build:gh-pages": "vite build --base=/cv/",
    "build:html": "vite build",
    "build:pdf": "node src/generatePDF.js",
    "build:timestamp": "pnpm dlx replace-in-files-cli --string __LAST_UPDATE__ --replacement `date -I` dist/index.html",
    "dev": "vite",
    "lint": "eslint . --fix",
    "prepare": "pnpm dlx simple-git-hooks",
    "preview": "vite preview"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm dlx lint-staged"
  },
  "lint-staged": {
    "**/*.js": [
      "pnpm run lint"
    ]
  },
  "prettier": {
    "arrowParens": "always",
    "bracketSpacing": true,
    "printWidth": 80,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "es5"
  }
}
